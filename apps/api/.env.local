# Local development configuration
DATABASE_URL=postgresql://bloom:bloom@localhost:5432/bloom
JWT_SECRET=local-dev-secret-key-not-for-production
ENVIRONMENT=development

# AWS Core
AWS_REGION=us-east-1

# Feature Flags
USE_COGNITO=true
USE_AWS_SECRETS=false
USE_CLOUDWATCH=false

# Cognito (ready to enable)
COGNITO_USER_POOL_ID=us-east-1_1sSZXSPwv
COGNITO_CLIENT_ID=5j7l03d6avbg43fh0hvvslom2f
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=bloom-dev.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# S3 Delivery Photos
S3_BUCKET_NAME=bloom-dev-delivery-photos
S3_REGION=us-east-1

# SES
SES_FROM_EMAIL=noreply@bloom.com
SES_REGION=us-east-1

# Secrets Manager
DB_SECRET_NAME=bloom/dev/db-credentials
JWT_SECRET_NAME=bloom/dev/jwt-secret

# CloudWatch
CLOUDWATCH_LOG_GROUP=/bloom/dev/api

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
