# Bloom API Environment Variables

# JWT secret key for signing tokens (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production

# Environment: development or production
ENVIRONMENT=development

# Production web domain for CORS (optional, single domain)
# WEB_DOMAIN=https://bloom.example.com

# Additional CORS origins (optional, comma-separated list)
# CORS_ORIGINS=https://main.abc123.amplifyapp.com,https://bloom.example.com

# Database Configuration (PostgreSQL)
# Option 1: Full connection URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Component variables (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloom
DB_USER=bloom_admin
DB_PASSWORD=your-db-password-here
