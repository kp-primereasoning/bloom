# Bloom API Environment Variables

# JWT secret key for signing tokens (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production

# Environment: development or production
ENVIRONMENT=development

# Production web domain for CORS (optional, single domain)
# WEB_DOMAIN=https://bloom.example.com

# Additional CORS origins (optional, comma-separated list)
# CORS_ORIGINS=https://main.abc123.amplifyapp.com,https://bloom.example.com

# Database Configuration (PostgreSQL)
# Option 1: Full connection URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Component variables (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloom
DB_USER=bloom_admin
DB_PASSWORD=your-db-password-here

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS Core
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Feature Flags (set to true to enable AWS services)
# -----------------------------------------------------------------------------
USE_COGNITO=false
USE_AWS_SECRETS=false
USE_CLOUDWATCH=false

# -----------------------------------------------------------------------------
# AWS Cognito (User Authentication)
# Required when USE_COGNITO=true
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_1sSZXSPwv
COGNITO_CLIENT_ID=5j7l03d6avbg43fh0hvvslom2f
COGNITO_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS S3 (Delivery Photo Storage)
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=bloom-dev-delivery-photos
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS SES (Email Service)
# -----------------------------------------------------------------------------
SES_FROM_EMAIL=noreply@bloom.com
SES_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Secrets Manager
# Required when USE_AWS_SECRETS=true
# -----------------------------------------------------------------------------
DB_SECRET_NAME=bloom/dev/database
JWT_SECRET_NAME=bloom/dev/jwt-secret

# -----------------------------------------------------------------------------
# AWS CloudWatch (Logging)
# Required when USE_CLOUDWATCH=true
# -----------------------------------------------------------------------------
CLOUDWATCH_LOG_GROUP=/bloom/dev/api
