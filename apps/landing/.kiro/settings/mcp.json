{
  "mcpServers": {
    "brave-web-search": {
      "command": "uvx",
      "args": [
        "mcp-server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": ""
      },
      "disabled": true,
      "autoApprove": []
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "disabled": false,
      "autoApprove": [
        "get_project_registries",
        "search_items_in_registries",
        "get_add_command_for_items"
      ]
    }
  }
}