# Shopify App Credentials (from Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# App URL (use ngrok or cloudflare tunnel for local dev)
SHOPIFY_APP_URL=https://localhost:3000

# Bloom API connection
BLOOM_API_URL=http://localhost:8000
BLOOM_API_KEY=

# Database for session storage
DATABASE_URL="file:./dev.db"

# Scopes requested from Shopify
SCOPES=read_products,read_orders,read_inventory
